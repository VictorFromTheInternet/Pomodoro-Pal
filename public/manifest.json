{
    "manifest_version": 3,
    "version": "1.0.0",
    "name":"Pomodoro Pal",
    "description":"An easy to use interval timer for productivity!",
    "icons":{
        "16":"Pomodoro_Pal_16.png",
        "32":"Pomodoro_Pal_32.png",
        "48":"Pomodoro_Pal_48.png",
        "128":"Pomodoro_Pal_128.png"        
    },
    "action":{
        "default_popup":"popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts":[{
        "matches": ["<all_urls>"],
        "js":["content.js"],
        "run_at":"document_end"
    }],
    "permissions":[
        "scripting",
        "tabs",
        "activeTab",
        "notifications"
    ],
    "host_permissions":[
        "http://*/*",
        "https://*/*"
    ],
    "web_accessible_resources":[{
        "resources": ["*.gif", "*.png"],
        "matches": ["<all_urls>"]
    }]

}